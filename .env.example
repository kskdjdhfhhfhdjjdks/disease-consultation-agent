# 复制本文件为 .env 并填入实际值（config.py 会自动加载 .env）

# ---- Neo4j ----
# 本地：bolt://127.0.0.1:7687
# 云端 AuraDB：neo4j+ssc://<你的实例id>.databases.neo4j.io
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=改成你的密码

# ---- Milvus（本地向量库，云端可关）----
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# ---- Embedding ----
EMBED_DIM=256
EMBED_MODEL=ngram
LINK_THRESHOLD=0.6

# ---- LLM ----
ANTHROPIC_MODEL=claude-opus-5

# ---- 追问 ----
MAX_FOLLOWUP_ROUNDS=3

# ---- 部署开关（云端 Render 部署时用）----
# 云端无 Milvus 时设为 false
USE_MILVUS=false
# 允许跨域的前端来源（Netlify 站点地址），多个用英文逗号分隔
CORS_ORIGINS=https://你的站点.netlify.app
